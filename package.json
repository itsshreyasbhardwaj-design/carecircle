{
  "name": "carecircle",
  "version": "0.1.0",
  "private": true,
  "description": "CareCircle — family healthcare coordination. Local-first, no external API keys required.",
  "scripts": {
    "dev": "npm run migrate --silent && next dev -p 3100",
    "build": "next build",
    "start": "npm run migrate --silent && next start -p 3100",
    "migrate": "node scripts/migrate.ts",
    "seed:demo": "node scripts/seed-demo.ts",
    "reset:demo": "node scripts/seed-demo.ts --reset",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "setup:ocr": "node scripts/setup-ocr.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^6.0.1",
    "unpdf": "^0.12.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "tar": "^7.5.7"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "type": "module"
}
